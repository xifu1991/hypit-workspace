{
  "format": "hypit.runtime-local@1",
  "dataRoot": ".hypit/runtimes/local",
  "credentials": {
    "os": {
      "use": "@hypit/credential-store-os"
    }
  },
  "endpoints": {
    "hypihub.default": {
      "use": "@hypit/provider-hypihub",
      "config": {
        "baseUrl": "https://hypit.ai",
        "apiKey": {
          "store": "os",
          "key": "hypihub.oauth"
        }
      }
    },
    "volc-asr.default": {
      "use": "@hypit/provider-volc-asr",
      "config": {
        "configPath": "C:/Users/admin/Documents/视频制作/config.json",
        "defaultConcurrency": 2,
        "deleteTemporaryObject": true,
        "temporaryObjectPrefix": "hypit-volc-asr",
        "presignExpiresSeconds": 3600
      }
    },
    "media.local": {
      "use": "@hypit/provider-media-local",
      "config": {
        "ffmpegPath": "C:/Users/admin/Documents/视频制作/tools/ffmpeg/ffmpeg.exe",
        "ffprobePath": "C:/Users/admin/Documents/视频制作/tools/ffmpeg/ffprobe.exe"
      }
    },
    "hyperframes.local": {
      "use": "@hypit/provider-hyperframes-local"
    }
  },
  "bindings": {
    "@hypit/whisperx@1#whisperx-alignment": "volc-asr.default"
  }
}
