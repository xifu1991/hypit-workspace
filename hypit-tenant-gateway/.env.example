NODE_ENV=production
HOST=0.0.0.0
PORT=8787
DATA_DIR=./data
APP_ORIGIN=https://studio.example.com
COOKIE_SECURE=true
# Local sandboxed previews only. Never enable this on the public server.
ALLOW_NULL_ORIGIN=false
MAX_BODY_BYTES=67108864
SESSION_TTL_HOURS=72
# Shared only by the SaaS backend for server-to-server management.
SAAS_BRIDGE_SECRET=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# mock is safe for local acceptance tests. Use volc only after all credentials are configured.
PROVIDER_MODE=mock

VOLC_TTS_ENDPOINT=https://openspeech.bytedance.com
VOLC_TTS_API_KEY=
VOLC_TTS_RESOURCE_ID=seed-icl-2.0
VOLC_TTS_DEFAULT_SPEAKER=
VOLC_TTS_FORMAT=mp3
VOLC_TTS_SAMPLE_RATE=24000

VOLC_ASR_ENDPOINT=https://openspeech.bytedance.com
VOLC_ASR_API_KEY=
VOLC_ASR_RESOURCE_ID=volc.seedasr.auc
VOLC_ASR_ENABLE_SPEAKER=true

VOLC_TOS_ENDPOINT=https://tos-cn-shanghai.volces.com
VOLC_TOS_REGION=cn-shanghai
VOLC_TOS_BUCKET=
VOLC_TOS_ACCESS_KEY=
VOLC_TOS_SECRET_KEY=
VOLC_TOS_PREFIX=hypit-tenant-gateway/asr
VOLC_TOS_PRESIGN_SECONDS=3600

# Defaults are intentionally visible and editable from the admin console.
DEFAULT_ASR_MICROFEN_PER_SECOND=1000000
DEFAULT_TTS_MICROFEN_PER_1000_CHARS=20000
DEFAULT_TOS_MICROFEN_PER_MIB=1000000
